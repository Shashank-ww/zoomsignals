generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signal {
  id               String         @id @default(uuid())
  formatName       String         @unique
  insight          String
  lifecycle        Lifecycle
  velocity         Velocity
  confidence       Confidence
  approvalStatus   ApprovalStatus
  repetitionCount  Int
  author           String?
  imageUrl         String?
  sourceLink       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notRelevantCount Int            @default(0)
  relevantCount    Int            @default(0)
  narrative        Narrative
  primaryPlatforms Platform[]
  resonanceScore   Float          @default(0)
  votes            Vote[]
  advertiser       Advertiser[]   @relation("AdvertiserToSignal")
}

model Advertiser {
  id        String   @id @default(uuid())
  brandName String   @unique
  createdAt DateTime @default(now())
  signals   Signal[] @relation("AdvertiserToSignal")
}

model Vote {
  id        String   @id @default(uuid())
  signalId  String
  type      VoteType
  voterHash String
  createdAt DateTime @default(now())
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ImportLog {
  id        String   @id @default(cuid())
  fileName  String
  mode      String
  inserted  Int
  updated   Int
  failed    Int
  createdAt DateTime @default(now())
}

enum Lifecycle {
  EARLY
  PEAKING
  SATURATED
}

enum Velocity {
  EMERGING
  ACCELERATING
  STABLE
  DECLINING
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  META_PAID
  TWITTER
  YOUTUBE
  SNAPCHAT
  REDDIT
  WHATSAPP
  LINKEDIN
  PINTEREST
}

enum Narrative {
  THEMATIC
  CONTEXTUAL
  TACTICAL
  STORYTELLING
  VO_MUSICAL
  EMOTIONAL
  INFLUENCER_LED
  AUTHORITY_LED
  COMPARATIVE
  TESTIMONIAL
}

enum VoteType {
  RELEVANT
  NOT_RELEVANT
}
