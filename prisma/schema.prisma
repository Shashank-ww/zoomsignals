generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Signal {
  id               String         @id @default(uuid())
  formatName       String         @unique
  narrative        Narrative
  insight          String
  lifecycle        Lifecycle
  velocity         Velocity
  confidence       Confidence
  approvalStatus   ApprovalStatus
  primaryPlatforms Platform[]
  repetitionCount  Int
  author           String?
  imageUrl         String?
  sourceLink       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notRelevantCount Int            @default(0)
  relevantCount    Int            @default(0)
  resonanceScore   Float          @default(0)

  advertiser       Advertiser[]

  votes            Vote[]
}

model Advertiser {
  id        String   @id @default(uuid())
  brandName String   @unique
  signals   Signal[]

  createdAt DateTime @default(now())
}

model Vote {
  id        String   @id @default(uuid())
  signalId  String
  type      VoteType
  voterHash String
  createdAt DateTime @default(now())
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ImportLog {
  id         String   @id @default(cuid())
  fileName   String
  mode       String
  inserted   Int
  updated    Int
  failed     Int
  createdAt  DateTime @default(now())
}

enum Lifecycle {
  EARLY
  PEAKING
  SATURATED
}

enum Velocity {
  EMERGING
  ACCELERATING
  STABLE
  DECLINING
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  META_PAID
  TWITTER
  GOOGLE_YT
}

enum Narrative {
  SILENT
  TACTICAL
  TEXT_ONLY
  VO_ONLY
  VISUAL_ONLY
  BG_MUSIC_ONLY
  COMPARATIVE
}

enum VoteType {
  RELEVANT
  NOT_RELEVANT
}
